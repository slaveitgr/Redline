<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
 <vendor>Slave IT Solutions — Greece</vendor>
 <vendor_url>https://slave.gr</vendor_url>
 <action id="io.github.redline.native.setup">
  <description>Set up Redline hardware access</description>
  <message>Administrator approval is required to grant this account access to Redline GPU and CPU controls.</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/redline/redline-setup</annotate>
 </action>
</policyconfig>
