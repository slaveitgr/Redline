[Unit]
Description=Redline CPU control helper
[Service]
Type=dbus
BusName=io.github.redline.native.helper
ExecStart=/usr/libexec/redline/redline_helper
RuntimeDirectory=redline-cpu
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/sys/devices/system/cpu
