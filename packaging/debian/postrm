#!/bin/sh
set -e
if [ "$1" = purge ]; then deb-systemd-helper purge redline-gpu.socket >/dev/null || true; fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
if command -v update-desktop-database >/dev/null; then update-desktop-database -q; fi
# Hardware-access membership and user settings are retained to avoid removing administrator-owned policy or user data.
